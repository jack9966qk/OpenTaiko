default_platform(:ios)

BETA_GROUPS = ["beta"].freeze
APP_IDENTIFIER = "com.opentaiko.mobile".freeze

def asc_api_key
  api_key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
  is_base64 = !api_key_content.include?("-----BEGIN")
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: api_key_content,
    is_key_content_base64: is_base64
  )
end

platform :ios do
  desc "Resigns an unsigned IPA"
  lane :resign_ipa do |options|
    ipa_path = options[:ipa_path]

    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("Could not find IPA at path: #{ipa_path}")
    end

    resign(
      ipa: ipa_path,
      signing_identity: ENV["SIGNING_IDENTITY"],
      provisioning_profile: ENV["PROVISIONING_PROFILE_PATH"],
      bundle_id: APP_IDENTIFIER
    )
  end

  desc "Uploads a signed IPA to TestFlight and distributes it to the beta group (fallback if altool fails)"
  lane :upload_ipa do |options|
    ipa_path = options[:ipa_path]

    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("Could not find IPA at path: #{ipa_path}")
    end

    upload_to_testflight(
      ipa: ipa_path,
      api_key: asc_api_key,
      groups: BETA_GROUPS,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Distributes a processed build on App Store Connect to the beta group"
  lane :distribute_to_testers do |options|
    # Distribute the exact build just uploaded (passed as build_number/app_version by the
    # release workflow, read from the IPA with PlistBuddy), not merely the latest
    # *already-processed* build. Otherwise a release run distributes an older build while the
    # freshly uploaded one is still processing. With no build given (e.g. the manual distribute
    # workflow) it falls back to the latest build.
    build_number = options[:build_number]
    app_version = options[:app_version]
    if build_number.to_s.empty?
      UI.important("No build_number given; distributing the latest build")
      build_number = nil
      app_version = nil
    end

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      distribute_only: true,
      build_number: build_number,
      app_version: app_version,
      groups: BETA_GROUPS,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Lists recent TestFlight builds and their processing state (read-only diagnostic)"
  lane :list_builds do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found for this API key") if app.nil?
    builds = app.get_builds(sort: "-uploadedDate", includes: "preReleaseVersion", limit: 25)
    UI.important("Recent builds for #{APP_IDENTIFIER} (app id #{app.id}):")
    builds.each do |b|
      train = b.pre_release_version&.version
      UI.message("  v#{train} (build #{b.version})  state=#{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
  end
end
